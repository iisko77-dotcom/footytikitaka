    function cellMatches(rowCrit, colCrit) {
      return PLAYERS.filter(player => meetsCriterion(player, rowCrit) && meetsCriterion(player, colCrit));
    }

    // Generate only boards where every one of the 9 squares has real answers.
    // We also require at least 2 possible players per square so a board does not
    // accidentally become a one-player trivia trap.
    function findValidBoard() {
      for (let attempt = 0; attempt < 10000; attempt++) {
        const shuffled = [...CRITERIA_POOL].sort(() => Math.random() - 0.5);
        const cols = shuffled.slice(0, 3);
        const rows = shuffled.slice(3, 6);

        const counts = rows.map(rowCrit => cols.map(colCrit => cellMatches(rowCrit, colCrit).length));
        const minCount = Math.min(...counts.flat());

        if (minCount >= 2) {
          return { rows, cols, counts };
        }
      }

      // Extremely unlikely fallback: choose a board with at least one answer
      // per square rather than displaying an impossible board.
      for (let attempt = 0; attempt < 10000; attempt++) {
        const shuffled = [...CRITERIA_POOL].sort(() => Math.random() - 0.5);
        const cols = shuffled.slice(0, 3);
        const rows = shuffled.slice(3, 6);
        const counts = rows.map(rowCrit => cols.map(colCrit => cellMatches(rowCrit, colCrit).length));
        if (Math.min(...counts.flat()) >= 1) return { rows, cols, counts };
      }

      return null;
    }

