  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>La Liga Footy Tic-Tac-Toe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap');

    :root {
      --laliga-navy: #0a0f1d;
      --laliga-card: #151c2e;
      --laliga-red: #ff004b;
      --laliga-gold: #f59e0b;
      --laliga-cyan: #06b6d4;
      --laliga-border: #263350;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--laliga-navy);
      color: #f8fafc;
      min-height: 100vh;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(255, 0, 75, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(6, 182, 212, 0.08) 0%, transparent 40%);
    }

    .laliga-gradient-text {
      background: linear-gradient(135deg, #ffffff 30%, #ff004b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .glow-red {
      box-shadow: 0 0 20px rgba(255, 0, 75, 0.35);
    }

    .glow-cyan {
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
    }

    /* Grid layout */
    .game-grid {
      display: grid;
      grid-template-columns: 85px repeat(3, minmax(0, 1fr));
      grid-template-rows: 85px repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    @media (max-width: 640px) {
      .game-grid {
        grid-template-columns: 65px repeat(3, minmax(0, 1fr));
        grid-template-rows: 65px repeat(3, minmax(0, 1fr));
        gap: 6px;
      }
    }

    .grid-cell {
      aspect-ratio: 1 / 1;
      background-color: var(--laliga-card);
      border: 1px solid var(--laliga-border);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cell-interactive:hover {
      border-color: var(--laliga-red);
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(255, 0, 75, 0.25);
    }

    /* Custom scrollbar for player list */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #0f172a;
      border-radius: 4px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: var(--laliga-red);
    }

    @keyframes pulseModal {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .animate-modal {
      animation: pulseModal 0.2s ease-out forwards;
    }
  </style>
</head>
