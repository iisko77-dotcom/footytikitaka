        <div class="grid-cell rounded-xl flex flex-col items-center justify-center p-2 text-center bg-[#182238] border-slate-700/50" id="col-2"></div>

        <!-- Row 0 -->
        <div class="grid-cell rounded-xl flex flex-col items-center justify-center p-2 text-center bg-[#182238] border-slate-700/50" id="row-0"></div>
        <button class="grid-cell cell-interactive rounded-xl flex flex-col items-center justify-center relative cursor-pointer group" data-row="0" data-col="0"></button>
        <button class="grid-cell cell-interactive rounded-xl flex flex-col items-center justify-center relative cursor-pointer group" data-row="0" data-col="1"></button>
        <button class="grid-cell cell-interactive rounded-xl flex flex-col items-center justify-center relative cursor-pointer group" data-row="0" data-col="2"></button>

        <!-- Row 1 -->
