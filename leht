      { type: 'pos', value: 'FWD', label: 'Forward', icon: '⚽' },
      { type: 'pos', value: 'MID', label: 'Midfielder', icon: '🎯' },
      { type: 'pos', value: 'DEF', label: 'Defender', icon: '🛡️' },
      { type: 'pos', value: 'GK', label: 'Goalkeeper', icon: '🧤' }
    ];

    let gameState = {
      board: Array(3).fill(null).map(() => Array(3).fill(null)),
      currentPlayer: 'X',
      activeCell: null,
      rowCriteria: [],
      colCriteria: [],
      isGameOver: false
    };

    function initGame() {
      // Pick random unique row/col criteria
      let shuffled = [...CRITERIA_POOL].sort(() => 0.5 - Math.random());
      
      let cols = shuffled.slice(0, 3);
      let rows = shuffled.slice(3, 6);

      gameState = {
        board: Array(3).fill(null).map(() => Array(3).fill(null)),
        currentPlayer: 'X',
        activeCell: null,
        rowCriteria: rows,
        colCriteria: cols,
        isGameOver: false
      };

      // Render Headers
      cols.forEach((crit, i) => {
        document.getElementById(`col-${i}`).innerHTML = `
          <span class="text-base md:text-xl mb-1">${crit.icon}</span>
          <span class="text-[11px] md:text-xs font-black text-slate-200 leading-tight uppercase tracking-wider">${crit.label}</span>
        `;
      });

      rows.forEach((crit, i) => {
        document.getElementById(`row-${i}`).innerHTML = `
          <span class="text-base md:text-xl mb-1">${crit.icon}</span>
          <span class="text-[11px] md:text-xs font-black text-slate-200 leading-tight uppercase tracking-wider">${crit.label}</span>
        `;
      });

      // Clear cell graphics
      document.querySelectorAll('.cell-interactive').forEach(cell => {
        cell.className = 'grid-cell cell-interactive rounded-xl flex flex-col items-center justify-center relative cursor-pointer group p-1';
        cell.innerHTML = `
          <div class="w-2 h-2 rounded-full bg-slate-700/50 group-hover:bg-red-500 transition-colors"></div>
        `;
      });

      updateTurnUI();
    }

    function updateTurnUI() {
      const statusMessage = document.getElementById('status-message');
      const boxX = document.getElementById('playerX-box');
      const boxO = document.getElementById('playerO-box');

      if (gameState.isGameOver) return;

      if (gameState.currentPlayer === 'X') {
        statusMessage.innerHTML = `<span class="text-red-500 font-extrabold">X</span>'s Turn`;
        boxX.className = "flex items-center gap-2.5 px-4 py-2 rounded-xl transition-all duration-300 bg-red-950/40 border border-red-500/40 glow-red";
        boxO.className = "flex items-center gap-2.5 px-4 py-2 rounded-xl transition-all duration-300 opacity-40 border border-transparent";
      } else {
        statusMessage.innerHTML = `<span class="text-cyan-400 font-extrabold">O</span>'s Turn`;
        boxO.className = "flex items-center gap-2.5 px-4 py-2 rounded-xl transition-all duration-300 bg-cyan-950/40 border border-cyan-500/40 glow-cyan";
        boxX.className = "flex items-center gap-2.5 px-4 py-2 rounded-xl transition-all duration-300 opacity-40 border border-transparent";
      }
    }

    function handleCellClick(r, c) {
      if (gameState.isGameOver || gameState.board[r][c] !== null) return;

      gameState.activeCell = { row: r, col: c };
      const rowCrit = gameState.rowCriteria[r].label;
      const colCrit = gameState.colCriteria[c].label;

      document.getElementById('modal-title').innerText = `${rowCrit} + ${colCrit}`;
      document.getElementById('search-input').value = '';
      
      filterPlayers();
      openModal();
    }

    function openModal() {
      document.getElementById('modal-overlay').classList.remove('hidden');
      document.getElementById('search-input').focus();
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.add('hidden');
    }

    function showAlert(title, text) {
      document.getElementById('alert-title').innerText = title;
      document.getElementById('alert-body').innerText = text;
      document.getElementById('alert-modal').classList.remove('hidden');
    }

    function closeAlert() {
      document.getElementById('alert-modal').classList.add('hidden');
    }

    function filterPlayers() {
      const query = document.getElementById('search-input').value.toLowerCase().trim();
      const listEl = document.getElementById('player-list');
      listEl.innerHTML = '';

      const matches = PLAYERS.filter(p => p.name.toLowerCase().includes(query));

      if (matches.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-6 text-slate-500 text-xs">
            No player found in database matching "${query}"
          </div>
        `;
        return;
      }

      matches.forEach(player => {
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-3 bg-[#0a0f1d] hover:bg-slate-800/80 border border-slate-800 hover:border-red-500/50 rounded-xl cursor-pointer transition-all group';
        item.innerHTML = `
          <div>
            <div class="font-bold text-slate-100 group-hover:text-red-400 transition-colors text-sm">${player.name}</div>
            <div class="text-[11px] text-slate-400 font-medium">${player.country} • ${player.pos}</div>
          </div>
          <div class="text-[10px] text-slate-500 bg-slate-900 border border-slate-800 px-2 py-1 rounded-md max-w-[140px] truncate">
            ${player.clubs.join(', ')}
          </div>
        `;
        item.onclick = () => selectPlayer(player);
        listEl.appendChild(item);
      });
    }

    function meetsCriterion(player, crit) {
      if (crit.type === 'club') return player.clubs.includes(crit.value);
      if (crit.type === 'country') return player.country === crit.value;
      if (crit.type === 'pos') return player.pos === crit.value;
      return false;
    }

    function selectPlayer(player) {
      closeModal();

      const { row, col } = gameState.activeCell;
      const rowCrit = gameState.rowCriteria[row];
      const colCrit = gameState.colCriteria[col];

      const matchesRow = meetsCriterion(player, rowCrit);
      const matchesCol = meetsCriterion(player, colCrit);

      if (matchesRow && matchesCol) {
        // Valid Move
        gameState.board[row][col] = gameState.currentPlayer;

        const cellEl = document.querySelector(`.cell-interactive[data-row="${row}"][data-col="${col}"]`);
        cellEl.onclick = null;
        cellEl.classList.remove('cell-interactive');
        
        const isX = gameState.currentPlayer === 'X';
        const colorClass = isX ? 'bg-red-950/80 border-red-500/80 text-red-400' : 'bg-cyan-950/80 border-cyan-500/80 text-cyan-400';
        const badgeColor = isX ? 'bg-red-600 text-white' : 'bg-cyan-600 text-white';

        cellEl.className = `grid-cell rounded-xl flex flex-col items-center justify-center relative p-1 text-center border ${colorClass}`;
        cellEl.innerHTML = `
          <span class="absolute top-1 right-1.5 w-4 h-4 rounded text-[10px] font-black flex items-center justify-center ${badgeColor}">
            ${gameState.currentPlayer}
          </span>
          <span class="text-xs md:text-sm font-black text-slate-100 leading-tight mt-1 line-clamp-2 px-1">${player.name}</span>
          <span class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">${player.country}</span>
        `;

        if (checkWin(gameState.currentPlayer)) {
          const winner = gameState.currentPlayer;
          document.getElementById('status-message').innerHTML = `🎉 <span class="${winner === 'X' ? 'text-red-500' : 'text-cyan-400'} font-extrabold">PLAYER ${winner} WINS!</span> 🎉`;
          gameState.isGameOver = true;
          return;
        }

        if (checkDraw()) {
          document.getElementById('status-message').innerHTML = `<span class="text-amber-400 font-extrabold">GAME DRAW!</span>`;
          gameState.isGameOver = true;
          return;
        }

        // Next Turn
        gameState.currentPlayer = gameState.currentPlayer === 'X' ? 'O' : 'X';
        updateTurnUI();

      } else {
        // Build clear feedback explanation
        let failedReason = [];
        if (!matchesRow) failedReason.push(`did not play for/represent "${rowCrit.label}"`);
        if (!matchesCol) failedReason.push(`did not play for/represent "${colCrit.label}"`);

        showAlert(
          "Invalid Selection!",
          `❌ ${player.name} ${failedReason.join(' and ')} during the 2010–2026 era. Turn passed to Player ${gameState.currentPlayer === 'X' ? 'O' : 'X'}!`
        );

        // Turn switches on wrong answer
        gameState.currentPlayer = gameState.currentPlayer === 'X' ? 'O' : 'X';
        updateTurnUI();
      }
    }

    function checkWin(p) {
      const b = gameState.board;
      for (let i = 0; i < 3; i++) {
        if (b[i][0] === p && b[i][1] === p && b[i][2] === p) return true;
        if (b[0][i] === p && b[1][i] === p && b[2][i] === p) return true;
      }
      if (b[0][0] === p && b[1][1] === p && b[2][2] === p) return true;
      if (b[0][2] === p && b[1][1] === p && b[2][0] === p) return true;
      return false;
    }

    function checkDraw() {
      return gameState.board.every(row => row.every(cell => cell !== null));
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.cell-interactive').forEach(cell => {
        cell.addEventListener('click', () => {
          const r = parseInt(cell.getAttribute('data-row'));
          const c = parseInt(cell.getAttribute('data-col'));
          handleCellClick(r, c);
        });
      });

      initGame();
    });
  </script>
</body>
</html>
